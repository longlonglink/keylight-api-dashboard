# Cloudflare Pages static headers.
# The connect-src policy limits browser API traffic to the official provider
# origins implemented in this repository. When another provider is added, add
# its official origin deliberately. Never add a backend or proxy origin.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://www.paypal.com; script-src 'self' 'sha256-eku5XsaUKyr/ZXAFnxC0BHu1MYj0EeHtyMqgJPfh6tY='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://www.paypalobjects.com; connect-src 'self' https://api.deepseek.com; manifest-src 'self'; upgrade-insecure-requests

# Hashed Vite assets never change at the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=3600

/llms-full.txt
  Cache-Control: public, max-age=3600
