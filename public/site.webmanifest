{
  "name": "KeyLight API Dashboard",
  "short_name": "KeyLight",
  "description": "Open-source API dashboard for checking supported API account information directly from the browser. No backend and no API key storage.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f3ec",
  "theme_color": "#0b3b2d",
  "lang": "en",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
